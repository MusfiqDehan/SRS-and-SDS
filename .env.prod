# ============================================================
# PRODUCTION environment configuration
# Used by docker-compose.prod.yml (root) and the per-app
# compose files.
#
# ⚠️  IMPORTANT: replace every secret below with strong,
# unique values before deploying. Never reuse these defaults.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=srs_sds_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=srs_sds
POSTGRES_PORT=5432
POSTGRES_SSL=false

# ---- Backend ----
NODE_ENV=production
BACKEND_PORT=4000
JWT_SECRET=CHANGE_ME_long_random_jwt_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://your-frontend-domain.com

# Seeded admin account (created automatically on first boot)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# ---- Frontend ----
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=https://your-api-domain.com/api
